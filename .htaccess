Options -Indexes

# Desliga cache do servidor LiteSpeed para esta pasta
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# Nunca cachear o HTML no browser
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

RewriteEngine On
RewriteBase /Skala-F/

# Serve arquivos reais diretamente (CSS, JS, imagens, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tudo o mais vai para financeiro.html
RewriteRule ^(.*)$ financeiro.html [L]
